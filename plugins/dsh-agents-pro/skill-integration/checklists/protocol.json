{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable checklist ID, e.g. development record folder name."
    },
    "title": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "merge",
        "replace"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "items"
  ],
  "additionalProperties": false
}
