{
  "name": "dsh-files-explorer",
  "description": "DeepSeek Harness Files-tree extras: keep the tree visible beside a file, and a VS Code-style right-click menu",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  }
}
